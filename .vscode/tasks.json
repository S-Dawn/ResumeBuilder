{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Dependencies",
			"type": "shell",
			"command": "uv",
			"args": [
				"sync"
			],
			"problemMatcher": []
		},
		{
			"label": "Update OpenSpec Libraries",
			"type": "shell",
			"command": "npx",
			"args": [
				"--yes",
				"@fission-ai/openspec@latest",
				"update"
			],
			"problemMatcher": []
		},
		{
			"label": "Build Resume",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"python",
				"-m",
				"python_engine.ResumeBuilder"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Run Resume Builder",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"python",
				"-m",
				"python_engine.ResumeBuilder"
			],
			"group": "none",
			"problemMatcher": []
		},
		{
			"label": "Run Python Tests",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"python",
				"-m",
				"unittest",
				"discover",
				"-s",
				"tests"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Build Python Package",
			"type": "shell",
			"command": "uv",
			"args": [
				"build"
			],
			"group": "none",
			"problemMatcher": []
		}
	]
}
